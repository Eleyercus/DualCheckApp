# Copia este archivo como .env.production antes de hacer "pnpm build" para
# desplegar en el servidor real. En desarrollo (pnpm dev) no hace falta,
# usa http://localhost:3001/api automáticamente.
#
# Sin este archivo, la app compilada seguiría apuntando a localhost:3001,
# lo cual solo funcionaría si se abre desde la misma máquina del servidor.

VITE_API_URL=http://IP_DEL_SERVIDOR:3001/api
